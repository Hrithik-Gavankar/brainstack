# Team Brain config — copy to .team-brain/team.yaml
# Personal BRAIN.md is never uploaded. credentials.json is gitignored.

version: 1

team:
  name: "Example Team"
  standup_channel: "#team-standup"

members:
  - id: alice
    name: "Alice Example"
    role: "Software Engineer"
    share_scopes: [research]

repos:
  - name: example-service
    path: "../example-service"

# One markdown file per initiative under initiatives/<id>.md
initiatives:
  - id: AAP-81423
    title: "Port and improve Ansible Tox integration"
    status: active
    file: initiatives/AAP-81423.md

sync:
  # supabase = multi-engineer capture sync | local = files/git only
  backend: supabase
  supabase_url: https://YOUR_PROJECT.supabase.co
  supabase_anon_key: YOUR_ANON_KEY
  # Member api_key lives in credentials.json (from register/join) — do not put it here

jira:
  site: https://redhat.atlassian.net
