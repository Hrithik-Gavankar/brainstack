# Team Brain config — copy to .team-brain/team.yaml
# Personal BRAIN.md is never uploaded. credentials.json is gitignored.

version: 1

team:
  name: "Example Team"
  standup_channel: "#team-standup"

members:
  - id: alice
    name: "Alice Example"
    role: "Software Engineer"
    share_scopes: [research]

repos:
  - name: example-service
    path: "../example-service"

# One markdown file per initiative under initiatives/<id>.md
initiatives:
  - id: YOU_JIRA_TICKET_HERE
    title: "Port and improve Ansible Tox integration"
    status: active
    file: initiatives/YOU_JIRA_TICKET_HERE.md

sync:
  # supabase = multi-engineer memory sync | local = files/git only
  backend: supabase
  supabase_url: https://YOUR_PROJECT.supabase.co
  supabase_anon_key: YOUR_ANON_KEY
  # Member api_key lives in credentials.json (from register/join) — do not put it here

# Optional semantic recall (P2). Prefer env vars over committing keys:
#   TEAM_BRAIN_EMBED_PROVIDER=openai|ollama
#   TEAM_BRAIN_EMBED_API_KEY=...   # openai
#   TEAM_BRAIN_EMBED_MODEL=text-embedding-3-small
# Vectors are 768-d. Omit provider → FTS-only recall.
#
# Parsing: install `yq` for robust YAML; without yq, keep sync.* values
# flat, unquoted, single-line.

jira:
  site: https://your-org.atlassian.net
