# Team Brain — runtime config (usually AUTO-WRITTEN by admin-setup → bootstrap).
#
# Admins: fill supabase/admin.setup.env instead (one file), then run:
#   bash core/scripts/team-brain-admin-setup.sh
#
# Joiners: admin sends .team-brain/share-bundle.txt via DM — copy URL + anon here
#   or pass --url / --anon to team-brain-member-setup.sh.
#
# Do NOT put service_role keys or member api_keys here.

TEAM_BRAIN_SUPABASE_URL=https://YOUR_REF.supabase.co
TEAM_BRAIN_SUPABASE_ANON_KEY=your-anon-key
TEAM_BRAIN_JIRA_SITE=https://your-org.atlassian.net
