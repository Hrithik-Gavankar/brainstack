# Team Brain — ADMIN setup (fill this ONE file, then run admin-setup)
#
#   cp supabase/admin.setup.env.example supabase/admin.setup.env
#   # edit every value below
#   bash core/scripts/team-brain-admin-setup.sh
#
# Gitignored — never commit live keys or invite codes.
#
# ── Where to get values ─────────────────────────────────────────────────────
# Supabase (hosted): https://supabase.com → your project → Settings → API
#   TEAM_BRAIN_SUPABASE_URL      → Project URL
#   TEAM_BRAIN_SUPABASE_ANON_KEY → anon / public key (NOT service_role)
# Migrations (optional): Settings → Database → connection string → TEAM_BRAIN_DB_URL
# Jira site: your org URL, e.g. https://redhat.atlassian.net
#
# Local Docker demo instead of hosted Supabase: set TEAM_BRAIN_USE_LOCAL=true
# (requires Docker + supabase CLI — URL/anon auto-filled)

# --- Required: you ---
TEAM_BRAIN_ADMIN_NAME=Your Name

# --- Required: crew + Jira epic ---
TEAM_BRAIN_TEAM_NAME=Your Crew
TEAM_BRAIN_JIRA_KEY=YOUR-EPIC
TEAM_BRAIN_JIRA_TITLE=Short title for your epic or spike
TEAM_BRAIN_JIRA_SITE=https://your-org.atlassian.net

# --- Required for hosted Supabase (leave empty when USE_LOCAL=true) ---
TEAM_BRAIN_SUPABASE_URL=https://YOUR_REF.supabase.co
TEAM_BRAIN_SUPABASE_ANON_KEY=your-anon-key

# --- Optional ---
# Postgres URI for auto migrations (needs psql). Never commit.
# One-time fully automated path (skip SQL Editor):
#   brew install libpq && brew link --force libpq
#   TEAM_BRAIN_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_REF.supabase.co:5432/postgres
TEAM_BRAIN_DB_URL=
# true = local Docker stack (supabase start) instead of hosted URL/anon above
TEAM_BRAIN_USE_LOCAL=false
# Usually leave false — admin-setup auto-detects migrations after SQL Editor run
TEAM_BRAIN_SKIP_MIGRATIONS=false
# true = skip team-brain-api.sh start at end of admin setup
TEAM_BRAIN_SKIP_START=false
