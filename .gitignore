# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc

# IDE
.vscode/
.cursor/
*.swp
*.swo

# Node.js
node_modules/
dashboard/dist/
website/build/
website/.docusaurus/
.env
.env.local

# Team Brain secrets (per-workspace only — do not blanket-ignore all of .team-brain/)
.team-brain/credentials.json
.team-brain/**/credentials.json
.team-brain/team.yaml
.team-brain/**/team.yaml
.team-brain/share-bundle.txt
.team-brain/**/share-bundle.txt
.team-brain/cache/
.team-brain/**/cache/
.team-brain/sync/
.team-brain/**/sync/
!.team-brain/**/.gitkeep
# Commit-safe pin (.team-brain/project.json) SHOULD be committed — never put anon/api_key/invite there.
# team.yaml holds URL+anon locally — gitignored above; prefer supabase/project.public.env.
supabase/project.public.env
supabase/admin.setup.env

# Bootstrap-generated combined SQL (may be large; never commit crew secrets beside it)
supabase/.bootstrap-migrations.combined.sql

# GCal MCP secrets (per-workspace only — default lives outside the repo in
# ~/.config/engineer-brain/gcal/, but guard the workspace-local override too)
.gcal/credentials.json
.gcal/**/credentials.json
**/*.token_cache.json
!.gcal/**/.gitkeep

# Personal data (uncomment if you fork and add your own data)
# core/BRAIN.md
# platforms/cursor/skills/engineer-brain/BRAIN.md
# .engineer-brain/BRAIN.md
# *.pdf
# RESUME.md

